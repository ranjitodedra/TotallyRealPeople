# Copy to .env.local and fill in. The app runs in fake mode without these.
GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LIVE_API_VERSION=v1alpha

AGENTBOXD_API_KEY=
AGENTBOXD_WEBHOOK_SECRET=

# Twilio phone number (calls + texts). Run with `npm run dev:phone`; see README "Phone number".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public https origin Twilio calls, e.g. your ngrok address. Must match the console webhook URLs.
PUBLIC_BASE_URL=
# Optional: which reference answers the number (default: the newest).
PHONE_REFERENCE_ID=

# Grok (xAI): text and/or voice. Get a key at console.x.ai.
GROK_API_KEY=
# ElevenLabs (voice only): ElevenLabs listens and speaks, the agent's custom LLM (Grok) writes the words.
# One agent for browser and phone. In the dashboard: Custom LLM https://api.x.ai/v1 with your xAI key as a secret,
# voice of your choice, audio PCM 16000 Hz in / PCM 24000 Hz out, authentication on, System prompt override on.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Which provider answers by default: "gemini" or "grok" (VOICE_PROVIDER can also be "elevenlabs"). Each reference can switch on the reference desk.
# If the chosen provider's key is missing, the other one answers (text falls back to fake mode with neither).
TEXT_PROVIDER=grok
VOICE_PROVIDER=elevenlabs
# Optional overrides
# GROK_TEXT_MODEL=grok-4.20-0309-non-reasoning   (fast; grok-4.7 reasons but takes ~12 s per chat answer)
# GROK_VOICE_MODEL=grok-voice-latest
# GROK_VOICE=rex
