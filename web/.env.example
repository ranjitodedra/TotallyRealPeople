# Copy to .env.local and fill in. The app runs in fake mode without these.
GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LIVE_API_VERSION=v1alpha

AGENTBOXD_API_KEY=
AGENTBOXD_WEBHOOK_SECRET=

# Twilio phone number (calls + texts). Run with `npm run dev:phone`; see README "Phone number".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public https origin Twilio calls, e.g. your ngrok address. Must match the console webhook URLs.
PUBLIC_BASE_URL=
# Optional: which reference answers the number (default: the newest).
PHONE_REFERENCE_ID=

# Grok (xAI): text and/or voice. Get a key at console.x.ai.
GROK_API_KEY=
# Which provider answers by default: "gemini" or "grok". Each reference can switch on the reference desk.
# If the chosen provider's key is missing, the other one answers (text falls back to fake mode with neither).
TEXT_PROVIDER=gemini
VOICE_PROVIDER=grok
# Optional overrides
# GROK_TEXT_MODEL=grok-4.20-0309-non-reasoning   (fast; grok-4.7 reasons but takes ~12 s per chat answer)
# GROK_VOICE_MODEL=grok-voice-latest
# GROK_VOICE=rex
